@model Clinic_Appointment_System.Models.Appointment
@{
    ViewData["Title"] = "Randevu detalları";
}

<div class="container mt-4">
    <h2>Randevu detalları</h2>

    <div class="card p-4">
        <h4>@Model.PatientName</h4>
        <hr />
        <p><strong>ID:</strong> @Model.Id</p>
        <p><strong>Telefon:</strong> @Model.Phone</p>
        <p><strong>Şöbə:</strong> @Model.Department</p>
        <p><strong>Qəbul tarixi:</strong> @Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Şikayət / Qeyd:</strong> @Model.Notes</p>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Redaktə et</a>
            <a asp-action="Index" class="btn btn-secondary">Geri</a>
        </div>
    </div>
</div>