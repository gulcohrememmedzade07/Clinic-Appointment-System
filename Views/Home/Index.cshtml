@{
    ViewData["Title"] = "Ana səhifə";
}

<div class="hero-banner mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-info text-dark mb-3 px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-shield-check me-1"></i> 24/7 Onlayn Qeydiyyat Sistemi
            </span>
            <h1 class="display-5 fw-bold mb-3">Sağlamlığınız üçün sürətli və rahat həkim randevusu</h1>
            <p class="lead opacity-75 mb-4">
                Növbə gözləmədən istədiyiniz tibbi şöbə üzrə həkim müayinəsinə onlayn yazılın və müraciətinizin statusunu real vaxtda izləyin.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-light text-primary fw-bold btn-lg px-4">
                    <i class="bi bi-calendar-plus me-2"></i>Yeni randevu yarat
                </a>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-list-ul me-2"></i>Randevulara bax
                </a>
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-flex justify-content-center">
            <i class="bi bi-hospital text-white opacity-25" style="font-size: 11rem;"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-heart-pulse"></i>
            </div>
            <h5 class="fw-bold">Peşəkar Şöbələr</h5>
            <p class="text-muted mb-0">Terapiya, Kardiologiya, Stomatologiya, Oftalmologiya və Nevrologiya üzrə ixtisaslaşmış qəbul.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="icon-box bg-success bg-opacity-10 text-success">
                <i class="bi bi-clock-history"></i>
            </div>
            <h5 class="fw-bold">Vaxta Qənaət</h5>
            <p class="text-muted mb-0">Özünüzə uyğun tarix və saatı seçərək klinikada gözləmədən birbaşa müayinəyə daxil olun.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="icon-box bg-info bg-opacity-10 text-info">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h5 class="fw-bold">Status İzləmə</h5>
            <p class="text-muted mb-0">Yaratdığınız randevuların təsdiqlənmə və tamamlanma vəziyyətini sistemdən rahatlıqla yoxlayın.</p>
        </div>
    </div>
</div>